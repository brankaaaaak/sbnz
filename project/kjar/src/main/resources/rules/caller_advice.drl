package com.ftn.sbnz.rules;

import com.ftn.sbnz.model.models.Call;
import com.ftn.sbnz.model.assessment.PatientAssessment;
import com.ftn.sbnz.model.models.CallerAdvice;
import com.ftn.sbnz.model.symptoms.FaintingSymptoms;
import com.ftn.sbnz.model.symptoms.InjuryHeadSymptoms;
import com.ftn.sbnz.model.symptoms.InjuryExtremitySymptoms;
import com.ftn.sbnz.model.enums.EmergencyLevel;
import com.ftn.sbnz.model.enums.IncidentType;
import com.ftn.sbnz.model.enums.ConsciousnessLevel;
import com.ftn.sbnz.model.enums.BloodPressure;

/**
 * Query: Da li je pad u nesvijest (FAINTING) bio uzrok koji je doveo do
 * finalnog nivoa prioritetnosti?
 * Dokazuje se ako: tip incidenta je FAINTING I pacijent je bio  UNCONSCIOUS_UNRESPONSIVE
 * ili UNCONSCIOUS_RESPONSIVE (tj. nesvjesno stanje je registrovano).
 */
query "faintingWasSymptom" (Long callId)
    $assessment : PatientAssessment(
        $cid : callId,
        $cid == callId,
        finalized == true,
        (consciousnessLevel == ConsciousnessLevel.UNCONSCIOUS_RESPONSIVE
            || consciousnessLevel == ConsciousnessLevel.UNCONSCIOUS_UNRESPONSIVE)
    )
    $call : Call(
        $cid2 : id,
        $cid2 == $cid,
        incidentType == IncidentType.FAINTING
    )
end

/**
 * Query: Da li hipotenzija prati pad u nesvijest?
 * Dokazuje se ako: FAINTING + bloodPressure == HYPOTENSION.
 */
query "faintingWithHypotension" (Long callId)
    $assessment : PatientAssessment(
        $cid : callId,
        $cid == callId,
        finalized == true,
        bloodPressure == BloodPressure.HYPOTENSION
    )
    $call : Call(
        $cid2 : id,
        $cid2 == $cid,
        incidentType == IncidentType.FAINTING
    )
end

/**
 * Query: Da li je udarac glave bio uzrok koji je doveo do finalnog nivoa?
 * Dokazuje se ako: tip incidenta je INJURY_HEAD.
 */
query "headInjuryWasSymptom" (Long callId)
    $assessment : PatientAssessment(
        $cid : callId,
        $cid == callId,
        finalized == true
    )
    $call : Call(
        $cid2 : id,
        $cid2 == $cid,
        incidentType == IncidentType.INJURY_HEAD
    )
end

/**
 * Query: Da li je pacijent pri udarcu glave bio pri svijesti?
 * Dokazuje se ako: INJURY_HEAD + consciousnessLevel == CONSCIOUS.
 */
query "headInjuryConscious" (Long callId)
    $assessment : PatientAssessment(
        $cid : callId,
        $cid == callId,
        finalized == true,
        consciousnessLevel == ConsciousnessLevel.CONSCIOUS
    )
    $call : Call(
        $cid2 : id,
        $cid2 == $cid,
        incidentType == IncidentType.INJURY_HEAD
    )
end

/**
 * Query: Da li je otvoren prelom bio simptom koji je doveo do finalnog nivoa?
 * Dokazuje se ako: INJURY_EXTREMITY + openFracture == true (u InjuryExtremitySymptoms).
 */
query "openFractureWasSymptom" (Long callId)
    $assessment : PatientAssessment(
        $cid : callId,
        $cid == callId,
        finalized == true
    )
    $call : Call(
        $cid2 : id,
        $cid2 == $cid,
        incidentType == IncidentType.INJURY_EXTREMITY
    )
    $symptoms : InjuryExtremitySymptoms(
        $cid3 : callId,
        $cid3 == $cid,
        openFracture == true
    )
end

// kreiranje CallerAdvice nakon finalizacije

rule "Advice - kreiranje CallerAdvice fakta"
salience 200
no-loop true
when
    $assessment : PatientAssessment(
        $callId : callId,
        finalized == true
    )
    not CallerAdvice(callId == $callId)
then
    CallerAdvice advice = new CallerAdvice($callId);
    insert(advice);
    System.out.println("Kreiran CallerAdvice za poziv " + $callId);
end

// SAVJETI

/**
 * Savjet 1: Pad u nesvijest -> dozivanje i provjera stanja svijesti pritiskom korijena nokta.
 *
 * Backward chaining: koristi query "faintingWasSymptom" da dokaže da je nesvjesno
 * stanje bilo prisutno kao simptom koji je doprinio finalnom nivou.
 */
rule "Advice - pad u nesvijest: provjera stanja svijesti"
salience 100
no-loop true
when
    $advice : CallerAdvice($callId : callId, $list: adviceList)
    faintingWasSymptom($callId;)
    not( String(this == "Dozovite pacijenta i provjerite stanje svijesti pritiskom na korijen nokta.") from $list )
then
    modify($advice) {
        addAdvice("Dozovite pacijenta i provjerite stanje svijesti pritiskom na korijen nokta.")
    };
    System.out.println("Advice: provjera stanja svijesti (pad u nesvijest) za poziv " + $callId);
end

/**
 * Savjet 2: Pad u nesvijest + hipotenzija -> eleviranje donjih ekstremiteta.
 *
 * Backward chaining: dokazuje i nesvjesno stanje I hipotenziju kao uzročne
 * simptome finalnog nivoa.
 */
rule "Advice - pad u nesvijest + hipotenzija: eleviranje ekstremiteta"
salience 100
no-loop true
when
    $advice : CallerAdvice($callId : callId, $list: adviceList)
    faintingWasSymptom($callId;)
    faintingWithHypotension($callId;)
    not( String(this == "Elevirati donje ekstremitete pacijenta (podignuti noge iznad nivoa srca).") from $list )
then
    modify($advice) {
        addAdvice("Elevirati donje ekstremitete pacijenta (podignuti noge iznad nivoa srca).")
    };
    System.out.println("Advice: eleviranje ekstremiteta (hipotenzija) za poziv " + $callId);
end

/**
 * Savjet 3: Udarac glave -> ne pomjerati pacijenta.
 *
 * Backward chaining: dokazuje da je udarac glave bio simptom koji je
 * doveo do finalnog nivoa prioritetnosti.
 */
rule "Advice - udarac glave: ne pomjerati pacijenta"
salience 100
no-loop true
when
    $advice : CallerAdvice($callId : callId, $list: adviceList)
    headInjuryWasSymptom($callId;)
    not( String(this == "Pacijenta NIKAKO ne treba pomjerati jer postoji rizik od povrede kicmene mozdine.") from $list )
then
    modify($advice) {
        addAdvice("Pacijenta NIKAKO ne treba pomjerati jer postoji rizik od povrede kicmene mozdine.")
    };
    System.out.println("Advice: ne pomjerati pacijenta (udarac glave) za poziv " + $callId);
end

/**
 * Savjet 4: Udarac glave + pacijent pri svijesti -> temporospacijalna orijentacija,
 * auto-orijentacija i aloorijentacija.
 *
 * Backward chaining: dokazuje udarac glave kao uzrok I da je pacijent pri svijesti.
 */
rule "Advice - udarac glave + pri svijesti: provjera orijentacije"
salience 100
no-loop true
when
    $advice : CallerAdvice($callId : callId, $list: adviceList)
    headInjuryWasSymptom($callId;)
    headInjuryConscious($callId;)
    not( String(this == "Provjerite orijentaciju pacijenta: temporospacijalna orijentacija (zna li gdje se nalazi i koje je vrijeme), auto-orijentacija (zna li ko je on/ona) i aloorijentacija (da li prepoznaje lica oko sebe).") from $list )
then
    modify($advice) {
        addAdvice("Provjerite orijentaciju pacijenta: temporospacijalna orijentacija (zna li gdje se nalazi i koje je vrijeme), auto-orijentacija (zna li ko je on/ona) i aloorijentacija (da li prepoznaje lica oko sebe).")
    };
    System.out.println("Advice: provjera orijentacije (udarac glave + svijest) za poziv " + $callId);
end

/**
 * Savjet 5: Otvoreni prelom -> zaustavljanje krvarenja, pokrivanje rane, imobilizacija.
 *
 * Backward chaining: dokazuje da je otvoreni prelom bio simptom koji je
 * doprinio finalnom nivou.
 */
rule "Advice - otvoreni prelom: zaustavljanje krvarenja"
salience 100
no-loop true
when
    $advice : CallerAdvice($callId : callId, $list : adviceList)
    openFractureWasSymptom($callId;)
    not( String(this == "Zaustavite krvarenje pritiskom OKO rane – nikako direktno na ranu.") from $list )
then
    modify($advice) {
        addAdvice("Zaustavite krvarenje pritiskom OKO rane – nikako direktno na ranu.")
    };
    System.out.println("Advice: zaustavljanje krvarenja za poziv " + $callId);
end

rule "Advice - otvoreni prelom: pokrivanje rane"
salience 100
no-loop true
when
    $advice : CallerAdvice($callId : callId, $list : adviceList)
    openFractureWasSymptom($callId;)
    not( String(this == "Pokrijte ranu sterilnom gazom ili čistom krpom.") from $list )
then
    modify($advice) {
        addAdvice("Pokrijte ranu sterilnom gazom ili čistom krpom.")
    };
    System.out.println("Advice: pokrivanje rane za poziv " + $callId);
end

rule "Advice - otvoreni prelom: imobilizacija"
salience 100
no-loop true
when
    $advice : CallerAdvice($callId : callId, $list : adviceList)
    openFractureWasSymptom($callId;)
    not( String(this == "Imobilizujte ozlijeđeni ekstremitet u zatečenom položaju.") from $list )
then
    modify($advice) {
        addAdvice("Imobilizujte ozlijeđeni ekstremitet u zatečenom položaju.")
    };
    System.out.println("Advice: imobilizacija za poziv " + $callId);
end

// ISPIS FINALNIH SAVJETA 

rule "Advice - ispis svih savjeta"
salience -100
no-loop true
when
    $advice : CallerAdvice($callId : callId)
    $assessment : PatientAssessment(callId == $callId, finalized == true, $level : finalLevel)
then
    System.out.println("     SAVJETI ZA POZIVAOCA (poziv " + $callId + ", nivo: " + $level + ")");
    for (String s : $advice.getAdviceList()) {
        System.out.println("  - " + s);
    }
end
