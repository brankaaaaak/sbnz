package com.ftn.sbnz.rules;

import com.ftn.sbnz.model.models.Call;
import com.ftn.sbnz.model.models.Patient;
import com.ftn.sbnz.model.assessment.PatientAssessment;
import com.ftn.sbnz.model.enums.*;
import com.ftn.sbnz.model.symptoms.StingSymptoms;
import com.ftn.sbnz.model.facts.*;

rule "Nivo2 - STING + nesvjestan -> RED"
no-loop true
when
    $call : Call($id : id, incidentType == IncidentType.STING, $patient : patient)

    PatientAssessment(
        callId == $id,
        consciousnessLevel != ConsciousnessLevel.CONSCIOUS
    )
then
    modify($call){
        setEmergencyLevel(EmergencyLevel.RED)
    };
    System.out.println("Nivo 2: STING + nesvjestan -> RED " + $id);
end

rule "Nivo2 - STING + nepravilno disanje -> YELLOW"
no-loop true
when
    $call : Call($id : id, incidentType == IncidentType.STING, $patient : patient)

    PatientAssessment(
        callId == $id,
        irregularBreathing == true,
        consciousnessLevel == ConsciousnessLevel.CONSCIOUS
    )
then
    modify($call){
        setEmergencyLevel(EmergencyLevel.YELLOW)
    };
    System.out.println("Nivo 2: STING + disanje -> YELLOW " + $id);
end

rule "Nivo2 - STING default -> GREEN"
no-loop true
when
    $call : Call($id : id, incidentType == IncidentType.STING)
    not PatientAssessment(callId == $id, irregularBreathing == true)
    not PatientAssessment(callId == $id, consciousnessLevel != ConsciousnessLevel.CONSCIOUS)
then
    modify($call){
        setEmergencyLevel(EmergencyLevel.GREEN)
    };
    System.out.println("Nivo 2: STING -> GREEN " + $id);
end

rule "Nivo3 - STING override RED (choking/swelling)"
salience 30
when
    $call : Call($id : id, incidentType == IncidentType.STING, $level : emergencyLevel)

    StingSymptoms(
        callId == $id,
        (choking == true || systemicSwelling == true)
    )
then
    modify($call){
        setEmergencyLevel(EmergencyLevel.RED)
    };
    System.out.println("Nivo 3: override RED " + $id);
end

rule "Nivo3 - GREEN + previous reaction -> YELLOW"
salience 20
when
    $call : Call($id : id, incidentType == IncidentType.STING,
                  emergencyLevel == EmergencyLevel.GREEN)

    StingSymptoms(
        callId == $id,
        previousSevereReaction == true
    )
then
    modify($call){
        setEmergencyLevel(EmergencyLevel.YELLOW)
    };
    System.out.println("Nivo 3: GREEN + history -> YELLOW " + $id);
end

rule "Nivo3 - YELLOW + previous reaction -> RED"
salience 25
when
    $call : Call($id : id, incidentType == IncidentType.STING,
                  emergencyLevel == EmergencyLevel.YELLOW)

    StingSymptoms(
        callId == $id,
        previousSevereReaction == true
    )
then
    modify($call){
        setEmergencyLevel(EmergencyLevel.RED)
    };
    System.out.println("Nivo 3: YELLOW + history -> RED " + $id);
end

rule "Nivo3 - only skin reaction -> no change"
when
    $call : Call($id : id, incidentType == IncidentType.STING,
                  emergencyLevel != null)

    StingSymptoms(
        callId == $id,
        skinReaction == true,
        choking == false,
        systemicSwelling == false,
        previousSevereReaction == false
    )
then
    System.out.println("Nivo 3: skin only - no change " + $id);
end