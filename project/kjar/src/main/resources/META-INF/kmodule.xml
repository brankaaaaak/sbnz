<kmodule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://jboss.org/kie/6.0.0/kmodule">
    <kbase name="rules" packages="rules" eventProcessingMode="stream">
        <ruleTemplate
            dtable="rules/pulse-template.drt.csv"
            template="rules/pulse-template.drt"
            row="2" col="1" />
        <ruleTemplate
            dtable="rules/blood-pressure-template.drt.csv"
            template="rules/blood-pressure-template.drt"
            row="2" col="1" />
        <ksession name="skjar" default="true"/>
    </kbase>
</kmodule>